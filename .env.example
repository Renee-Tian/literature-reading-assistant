# Flask 应用配置
SECRET_KEY=replace-with-your-local-secret

# 大语言模型配置（OpenAI 兼容接口，llm_service 读取以下四个键）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 单次生成实测可达 200 秒以上，建议不小于 420 秒
LLM_TIMEOUT=420

# 向量化配置（embedding_service 读取）
ARK_API_KEY=
ARK_EMBEDDING_MODEL=

# MySQL 配置（后续使用）
DB_HOST=
DB_PORT=
DB_NAME=literature_assistant
DB_USER=literature_app
DB_PASSWORD=
